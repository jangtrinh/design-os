{
  "name": "ease-design",
  "version": "0.5.0",
  "description": "Multi-runtime design-cli — describe what you want, get pro-taste UI.",
  "type": "module",
  "keywords": [
    "design",
    "design-cli",
    "ui-generation",
    "design-system",
    "design-tokens",
    "tailwind",
    "ai",
    "agent",
    "claude-code",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jangtrinh/design-os.git"
  },
  "homepage": "https://github.com/jangtrinh/design-os#readme",
  "bin": {
    "ui": "./dist/cli.js"
  },
  "exports": {
    "./lint": "./dist/lint.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "knowledge",
    "schemas",
    "templates"
  ],
  "workspaces": [
    "a11y",
    "recall"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "personas:verify": "node scripts/derive-personas-json.mjs",
    "verify:examples": "node scripts/normalize-example-theme.mjs --check && node scripts/normalize-example-roles.mjs --check && node scripts/build-examples-gallery.mjs --check && node scripts/capture-example-images.mjs --check",
    "prereg:022": "node tests/fixtures/spec-022-prereg/scripts/validate-prereg.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run build && npm test"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "css-select": "^7.0.0",
    "css-tree": "^3.2.1",
    "domutils": "^4.0.2",
    "htmlparser2": "^12.0.0"
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ease-design/schemas/product-context-receipt.schema.json",
  "title": "Product context receipt v1",
  "$comment": "ASCII ordering, uniqueness, scalar-count/lone-surrogate validation, and lifecycle semantics are enforced by the deterministic core.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "receiptId", "productId", "sourceRef", "sourceDigest", "capturedAt", "captureDisposition", "omittedCount", "reasonCodes", "claims"],
  "properties": {
    "kind": { "const": "product-context-receipt" },
    "version": { "const": 1 },
    "receiptId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "productId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "sourceRef": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "sourceDigest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "capturedAt": { "type": ["string", "null"], "format": "date-time" },
    "captureDisposition": { "enum": ["captured", "capped", "skipped", "blocked", "failed"] },
    "omittedCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "reasonCodes": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" } },
    "claims": { "type": "array", "maxItems": 256, "items": { "$ref": "#/definitions/claim" } }
  },
  "allOf": [
    { "if": { "properties": { "captureDisposition": { "const": "captured" } }, "required": ["captureDisposition"] }, "then": { "properties": { "sourceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "omittedCount": { "const": 0 }, "reasonCodes": { "maxItems": 0 }, "claims": { "minItems": 1 } } } },
    { "if": { "properties": { "captureDisposition": { "const": "capped" } }, "required": ["captureDisposition"] }, "then": { "properties": { "sourceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "omittedCount": { "minimum": 1, "maximum": 9007199254740991 }, "reasonCodes": { "minItems": 1 } } } },
    { "if": { "properties": { "captureDisposition": { "enum": ["skipped", "blocked", "failed"] } }, "required": ["captureDisposition"] }, "then": { "properties": { "omittedCount": { "const": 0 }, "reasonCodes": { "minItems": 1 }, "claims": { "maxItems": 0 } } } }
  ],
  "definitions": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "productText": { "$comment": "The core enforces Unicode scalar counts and rejects lone UTF-16 surrogates.", "type": "string", "minLength": 1, "maxLength": 2000 },
    "productTextList": { "type": "array", "maxItems": 256, "items": { "$ref": "#/definitions/productText" } },
    "flowString": { "$comment": "The core enforces Unicode scalar counts and rejects lone UTF-16 surrogates.", "type": "string", "minLength": 0, "maxLength": 500 },
    "flowIdentifier": { "allOf": [{ "$ref": "#/definitions/flowString" }, { "minLength": 1 }] },
    "screen": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "$ref": "#/definitions/flowIdentifier" }, "name": { "$ref": "#/definitions/flowString" }, "mode": { "$ref": "#/definitions/flowString" }, "artifact": { "$ref": "#/definitions/flowString" }, "states": { "type": "array", "maxItems": 64, "items": { "$ref": "#/definitions/flowString" } }, "terminal": { "type": "boolean" } } },
    "transition": { "type": "object", "additionalProperties": false, "required": ["id", "from", "to", "trigger"], "properties": { "id": { "$ref": "#/definitions/flowIdentifier" }, "from": { "$ref": "#/definitions/flowIdentifier" }, "to": { "$ref": "#/definitions/flowIdentifier" }, "trigger": { "enum": ["ON_CLICK", "ON_HOVER", "ON_PRESS", "AFTER_DELAY", "ON_KEY", "ON_SUBMIT"] }, "label": { "$ref": "#/definitions/flowString" }, "source": { "$ref": "#/definitions/flowString" }, "guard": { "$ref": "#/definitions/flowString" }, "async": { "type": "boolean" } } },
    "entryPoint": { "type": "object", "additionalProperties": false, "required": ["id", "screen"], "properties": { "id": { "$ref": "#/definitions/flowIdentifier" }, "screen": { "$ref": "#/definitions/flowIdentifier" }, "name": { "$ref": "#/definitions/flowString" } } },
    "flowScreens": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/definitions/screen" } },
    "flowTransitions": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/definitions/transition" } },
    "flowEntryPoints": { "type": "array", "maxItems": 1024, "items": { "$ref": "#/definitions/entryPoint" } },
    "typedClaimValue": { "allOf": [
      { "if": { "properties": { "field": { "const": "productTruth.audienceSituation" } }, "required": ["field"] }, "then": { "properties": { "value": { "$ref": "#/definitions/productText" } } } },
      { "if": { "properties": { "field": { "const": "productTruth.desiredChange" } }, "required": ["field"] }, "then": { "properties": { "value": { "$ref": "#/definitions/productText" } } } },
      { "if": { "properties": { "field": { "const": "productTruth.primaryOutcome" } }, "required": ["field"] }, "then": { "properties": { "value": { "$ref": "#/definitions/productText" } } } },
      { "if": { "properties": { "field": { "const": "productTruth.primaryAction" } }, "required": ["field"] }, "then": { "properties": { "value": { "$ref": "#/definitions/productText" } } } },
      { "if": { "properties": { "field": { "const": "productTruth.availableProof" } }, "required": ["field"] }, "then": { "properties": { "value": { "$ref": "#/definitions/productTextList" } } } },
      { "if": { "properties": { "field": { "const": "productTruth.prohibitedClaims" } }, "required": ["field"] }, "then": { "properties": { "value": { "$ref": "#/definitions/productTextList" } } } },
      { "if": { "properties": { "field": { "const": "productTruth.contentInventory" } }, "required": ["field"] }, "then": { "properties": { "value": { "$ref": "#/definitions/productTextList" } } } },
      { "if": { "properties": { "field": { "const": "flow.screens" } }, "required": ["field"] }, "then": { "properties": { "value": { "$ref": "#/definitions/flowScreens" } } } },
      { "if": { "properties": { "field": { "const": "flow.transitions" } }, "required": ["field"] }, "then": { "properties": { "value": { "$ref": "#/definitions/flowTransitions" } } } },
      { "if": { "properties": { "field": { "const": "flow.entryPoints" } }, "required": ["field"] }, "then": { "properties": { "value": { "$ref": "#/definitions/flowEntryPoints" } } } }
    ] },
    "claim": {
      "type": "object", "additionalProperties": false, "required": ["claimId", "field", "required", "disposition", "value", "reason", "supersedes"],
      "properties": {
        "claimId": { "$ref": "#/definitions/identifier" },
        "field": { "enum": ["flow.entryPoints", "flow.screens", "flow.transitions", "productTruth.audienceSituation", "productTruth.availableProof", "productTruth.contentInventory", "productTruth.desiredChange", "productTruth.primaryAction", "productTruth.primaryOutcome", "productTruth.prohibitedClaims"] },
        "required": { "type": "boolean" }, "disposition": { "enum": ["present", "missing", "empty", "stale", "rejected", "malformed", "partial", "not-evaluated"] },
        "value": { "$comment": "claim disposition controls null versus field-typed value: missing/empty/malformed/not-evaluated are null; present/partial/stale/rejected are typed." },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "supersedes": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}#[a-z0-9][a-z0-9._-]{0,127}$" } }
      },
      "allOf": [
        { "if": { "properties": { "disposition": { "enum": ["missing", "empty", "malformed", "not-evaluated"] } }, "required": ["disposition"] }, "then": { "properties": { "value": { "type": "null" } } } },
        { "if": { "properties": { "disposition": { "enum": ["present", "partial", "stale", "rejected"] } }, "required": ["disposition"] }, "then": { "$ref": "#/definitions/typedClaimValue" } }
      ]
    }
  }
}

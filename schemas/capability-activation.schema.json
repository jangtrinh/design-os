{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ease-design/schemas/capability-activation.schema.json",
  "title": "ease-design capability activation request or receipt",
  "oneOf": [
    { "$ref": "#/definitions/request" },
    { "$ref": "#/definitions/receiptV1" },
    { "$ref": "#/definitions/receiptV2" }
  ],
  "definitions": {
    "request": {
      "type": "object",
      "required": ["kind", "version", "rawRequest", "requestedSurface", "inputKind", "selectionEvidence"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "capability-activation-request" },
        "version": { "const": 1 },
        "rawRequest": { "type": "string", "minLength": 1 },
        "requestedSurface": { "type": "string", "minLength": 1 },
        "inputKind": { "type": "string", "minLength": 1 },
        "selectionEvidence": { "$ref": "#/definitions/selectionEvidence" }
      },
      "allOf": [{
        "if": {
          "properties": {
            "selectionEvidence": {
              "properties": { "kind": { "const": "documented-default" } },
              "required": ["kind"]
            }
          }
        },
        "then": { "properties": { "requestedSurface": { "const": "web-marketing" } } }
      }]
    },
    "receiptV1": {
      "type": "object",
      "required": ["kind", "version", "requestDigest", "catalogDigest", "requestedSurface", "inputKind", "selectionEvidence", "disposition", "route", "artifact", "selectedKnowledge", "machineWitnesses", "renderedWitnesses", "manualWitnesses", "action"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "capability-activation" },
        "version": { "const": 1 },
        "requestDigest": { "$ref": "#/definitions/digest" },
        "catalogDigest": { "$ref": "#/definitions/digest" },
        "requestedSurface": { "type": "string" },
        "inputKind": { "type": "string" },
        "selectionEvidence": { "$ref": "#/definitions/selectionEvidence" },
        "disposition": { "enum": ["QUALIFIED", "UNQUALIFIED"] },
        "route": { "type": ["string", "null"] },
        "artifact": { "type": "string" },
        "selectedKnowledge": { "$ref": "#/definitions/stringArray" },
        "machineWitnesses": { "$ref": "#/definitions/stringArray" },
        "renderedWitnesses": { "$ref": "#/definitions/stringArray" },
        "manualWitnesses": { "$ref": "#/definitions/stringArray" },
        "action": { "type": "string" }
      },
      "allOf": [
        { "$ref": "#/definitions/defaultSurfaceRule" },
        {
          "if": { "properties": { "disposition": { "const": "UNQUALIFIED" } } },
          "then": { "properties": { "route": { "const": null } } }
        },
        {
          "if": { "properties": { "disposition": { "const": "QUALIFIED" } } },
          "then": { "properties": { "route": { "type": "string", "minLength": 1 } } }
        }
      ]
    },
    "receiptV2": {
      "type": "object",
      "required": ["kind", "version", "requestDigest", "catalogDigest", "requestedSurface", "inputKind", "selectionEvidence", "routingDisposition", "assurance", "claimPolicy", "route", "artifact", "selectedKnowledge", "machineWitnesses", "renderedWitnesses", "manualWitnesses", "action"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "capability-activation" },
        "version": { "const": 2 },
        "requestDigest": { "$ref": "#/definitions/digest" },
        "catalogDigest": { "$ref": "#/definitions/digest" },
        "requestedSurface": { "type": "string" },
        "inputKind": { "type": "string" },
        "selectionEvidence": { "$ref": "#/definitions/selectionEvidence" },
        "routingDisposition": { "enum": ["ROUTED", "REFUSED"] },
        "assurance": { "enum": ["QUALIFIED", "PROVISIONAL", "UNASSESSED"] },
        "claimPolicy": { "enum": ["QUALIFIED_DELIVERY_ALLOWED", "QUALIFIED_DELIVERY_FORBIDDEN"] },
        "route": { "type": ["string", "null"] },
        "artifact": { "type": "string" },
        "selectedKnowledge": { "$ref": "#/definitions/stringArray" },
        "machineWitnesses": { "$ref": "#/definitions/stringArray" },
        "renderedWitnesses": { "$ref": "#/definitions/stringArray" },
        "manualWitnesses": { "$ref": "#/definitions/stringArray" },
        "action": { "type": "string" }
      },
      "allOf": [
        { "$ref": "#/definitions/defaultSurfaceRule" },
        {
          "if": { "properties": { "routingDisposition": { "const": "ROUTED" } } },
          "then": { "properties": { "route": { "type": "string", "minLength": 1 } } }
        },
        {
          "if": { "properties": { "routingDisposition": { "const": "REFUSED" } } },
          "then": { "properties": { "route": { "const": null } } }
        },
        {
          "if": { "properties": { "assurance": { "const": "QUALIFIED" } } },
          "then": {
            "properties": {
              "routingDisposition": { "const": "ROUTED" },
              "claimPolicy": { "const": "QUALIFIED_DELIVERY_ALLOWED" }
            }
          }
        },
        {
          "if": { "properties": { "assurance": { "const": "PROVISIONAL" } } },
          "then": {
            "properties": {
              "routingDisposition": { "const": "ROUTED" },
              "claimPolicy": { "const": "QUALIFIED_DELIVERY_FORBIDDEN" }
            }
          }
        },
        {
          "if": { "properties": { "assurance": { "const": "UNASSESSED" } } },
          "then": {
            "properties": {
              "routingDisposition": { "const": "REFUSED" },
              "claimPolicy": { "const": "QUALIFIED_DELIVERY_FORBIDDEN" }
            }
          }
        }
      ]
    },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "stringArray": { "type": "array", "items": { "type": "string" } },
    "defaultSurfaceRule": {
      "if": {
        "properties": {
          "selectionEvidence": {
            "properties": { "kind": { "const": "documented-default" } },
            "required": ["kind"]
          }
        }
      },
      "then": { "properties": { "requestedSurface": { "const": "web-marketing" } } }
    },
    "selectionEvidence": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "quote", "role"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "quoted-request" },
            "quote": { "type": "string", "minLength": 1 },
            "role": { "const": "requested-artifact" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "rule"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "documented-default" },
            "rule": { "const": "unspecified-page-output-defaults-to-web-marketing" }
          }
        }
      ]
    }
  }
}

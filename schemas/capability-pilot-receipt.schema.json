{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ease-design/schemas/capability-pilot-receipt.schema.json",
  "title": "Retained native capability pilot receipt",
  "type": "object",
  "required": [
    "kind",
    "version",
    "capabilityId",
    "pilotId",
    "surfaceCategory",
    "evidenceDisposition",
    "ownerVerdict",
    "ownerDisposition"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "design-os.capability-pilot-receipt" },
    "version": { "const": 1 },
    "capabilityId": { "type": "string", "minLength": 1 },
    "pilotId": { "type": "string", "minLength": 1 },
    "surfaceCategory": { "type": "string", "minLength": 1 },
    "evidenceDisposition": { "const": "retained" },
    "ownerVerdict": { "type": "string", "minLength": 1 },
    "ownerDisposition": { "type": "string", "minLength": 1 }
  }
}

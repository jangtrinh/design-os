{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ease-design/schemas/ruling-candidates.schema.json",
  "title": "ease-design ruling promotion candidates",
  "description": "Output of `ui knowledge promote`: scrubbed rulings proposed for the shared knowledge core. Deterministic — no timestamps, no file paths.",
  "type": "object",
  "required": ["schema", "params", "counts", "scrubbed", "candidates"],
  "properties": {
    "schema": { "const": "ruling-candidates/1" },
    "params": {
      "type": "object",
      "required": ["minRecurrence", "minSources"],
      "properties": {
        "minRecurrence": { "type": "integer", "minimum": 1 },
        "minSources": { "type": "integer", "minimum": 1 }
      }
    },
    "counts": {
      "type": "object",
      "required": ["considered", "candidates", "notLive", "unusable", "ledgerEvents", "ledgerSkippedLines"],
      "properties": {
        "considered": { "type": "integer", "minimum": 0 },
        "candidates": { "type": "integer", "minimum": 0 },
        "notLive": { "type": "integer", "minimum": 0 },
        "unusable": { "type": "integer", "minimum": 0 },
        "ledgerEvents": { "type": "integer", "minimum": 0 },
        "ledgerSkippedLines": { "type": "integer", "minimum": 0 }
      }
    },
    "scrubbed": {
      "description": "Replacement counts per kind (email, url, figma-key, abs-path, ip, hostname, project, person).",
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "text", "scope", "principle", "source", "reasons", "recurrence", "distinctSources"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "detail": { "type": "string" },
          "scope": {},
          "principle": { "type": "array", "items": { "type": "string" } },
          "source": { "type": "array", "items": { "type": "string" } },
          "reasons": { "type": "array", "minItems": 1, "items": { "enum": ["recurrence", "multi-source"] } },
          "recurrence": { "type": "integer", "minimum": 0 },
          "distinctSources": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ease-design.dev/schemas/ds-kit.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1

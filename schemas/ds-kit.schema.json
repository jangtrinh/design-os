      "minLength": 1,
      "pattern": "^(?!(?:\\.{1,2}|(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])(?:\\.[^/]*)?)(?:/|$))[^/\\\\\\x00-\\x1f\\x7f\\uD800-\\uDFFF<>:\"|?*]*[^/\\\\\\x00-\\x1f\\x7f\\uD800-\\uDFFF<>:\"|?*. ](?:/(?!(?:\\.{1,2}|(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])(?:\\.[^/]*)?)(?:/|$))[^/\\\\\\x00-\\x1f\\x7f\\uD800-\\uDFFF<>:\"|?*]*[^/\\\\\\x00-\\x1f\\x7f\\uD800-\\uDFFF<>:\"|?*. ])*$"

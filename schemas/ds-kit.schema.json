              "minLength": 1,
              "pattern": "^(?=\\s*\\S)[^\\x00-\\x1f\\x7f\\uD800-\\uDFFF]+$"
            },
            "uniqueItems": true
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?=\\s*\\S)[^\\x00-\\x1f\\x7f\\uD800-\\uDFFF]+$"
            },
            "uniqueItems": true
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?=\\s*\\S)[^\\x00-\\x1f\\x7f\\uD800-\\uDFFF]+$"
            },
            "uniqueItems": true
          },
          "tokensUsed": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?=\\s*\\S)[^\\x00-\\x1f\\x7f\\uD800-\\uDFFF]+$"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "sourceId",
          "name",
          "disposition"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "disposition": {
                  "const": "component"

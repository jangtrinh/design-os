    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=\\s*\\S)[^\\x00-\\x1f\\x7f\\uD800-\\uDFFF]+$",
      "maxLength": 64,
      "$comment": "Runtime also enforces the manifest UTF-16 code-unit limit; JSON Schema maxLength counts Unicode scalars."
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=\\s*\\S)[^\\x00-\\x1f\\x7f\\uD800-\\uDFFF]+$",
      "maxLength": 512,
      "$comment": "Runtime also enforces the manifest UTF-16 code-unit limit; JSON Schema maxLength counts Unicode scalars."
    },
    "target": {
      "const": "react-shadcn-tailwind"
    },

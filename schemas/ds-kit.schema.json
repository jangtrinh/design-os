              }
            },
            "then": {
              "required": [
                "implementation",
                "markup",
                "variants",
                "states",
                "cases"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "disposition": {
                  "enum": [
                    "icon",
                    "screen",
                    "excluded"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "reason",
                "cases"
              ]
            }
          }
        ]
      }
    },
    "artifacts": {

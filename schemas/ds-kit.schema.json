          },
          "hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$",
            "minLength": 71,
            "maxLength": 71
          },
          "scope": {
            "enum": [
              "partial",
              "complete"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?=\\s*\\S)[^\\x00-\\x1f\\x7f\\uD800-\\uDFFF]+$"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "kind",
          "path",
          "hash",
          "scope",
          "limitations"
        ]
      },
      "minItems": 1
    },
    "tokens": {

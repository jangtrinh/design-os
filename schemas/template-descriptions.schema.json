{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jangtrinh/ease-design/schemas/template-descriptions.schema.json",
  "title": "Template discovery descriptions",
  "description": "Generated by `ui templates catalogue`; the kernel reads this file instead of parsing template frontmatter. Uniqueness, path order and registry coverage are enforced by `ui templates lint`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "templates"],
  "properties": {
    "version": { "const": 1 },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "description", "sourceSha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(workflows|skills|journeys)/[a-z0-9]+(-[a-z0-9]+)*\\.md$"
          },
          "description": {
            "oneOf": [
              { "type": "string", "pattern": "^\\S(?:[^\\r\\n]*\\S)?$" },
              { "type": "null" }
            ]
          },
          "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}

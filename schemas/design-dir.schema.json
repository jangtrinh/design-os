{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ease-design.dev/schemas/design-dir.schema.json",
  "title": "design/ directory contract",
  "description": "Root: the optional manifest design/design-dir.json that declares token files derived from design/tokens.json. $defs.principlesIndex: the emitted design/principles.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "derived": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "derived_from"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "description": "Project-relative posix path of a generated token file" },
          "derived_from": { "const": "design/tokens.json" }
        }
      }
    }
  },
  "$defs": {
    "principlesIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source", "principles"],
      "properties": {
        "version": { "const": 1 },
        "source": { "type": "string", "minLength": 1 },
        "principles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "yields_when", "test"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Z]{1,3}[0-9]+$" },
              "title": { "type": "string", "minLength": 1 },
              "yields_when": { "type": "string", "minLength": 1 },
              "test": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}

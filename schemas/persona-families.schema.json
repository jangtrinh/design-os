{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "persona-families.schema.json",
  "title": "Persona families (measured attributes only)",
  "description": "knowledge/personas/families.json: the clustered persona families with only the reliable measured attributes and Mobbin URLs. Dossier prose is not carried here. Attributes whose extractor agreement is below 60% are named once in unreliableAttributes and omitted from every family.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source", "unreliableAttributes", "families", "token_mapping_rules"],
  "properties": {
    "version": { "const": 1 },
    "source": { "type": "string", "minLength": 1 },
    "token_mapping_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provenance", "rules"],
      "properties": {
        "provenance": { "const": "assumed" },
        "rules": { "type": "string", "minLength": 1 }
      }
    },
    "unreliableAttributes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attribute", "agreement"],
        "properties": {
          "attribute": { "type": "string", "pattern": "^[a-z_]+$" },
          "agreement": { "type": "number" }
        }
      }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "platform", "apps", "screens", "medoid", "nearest", "attributes", "mobbinUrls", "starting_tokens"],
        "properties": {
          "slug": { "type": "string", "pattern": "^(web|ios)-[a-z0-9-]+$" },
          "platform": { "enum": ["web", "ios"] },
          "apps": { "type": "number" },
          "screens": { "type": "number" },
          "medoid": { "type": "string", "minLength": 1 },
          "nearest": { "type": "string", "pattern": "^(web|ios)-[a-z0-9-]+$" },
          "accent": { "enum": ["required", "optional", "none"] },
          "owner_confirmed_by_eye": { "type": "boolean" },
          "history": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["action", "note"],
              "properties": {
                "action": { "enum": ["merged", "narrowed", "moved-in"] },
                "merged": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
                "kept": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                "removed": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                "added": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                "note": { "type": "string", "minLength": 1 }
              },
              "allOf": [
                { "if": { "properties": { "action": { "const": "merged" } } }, "then": { "required": ["merged"] } },
                { "if": { "properties": { "action": { "const": "narrowed" } } }, "then": { "required": ["removed", "kept"] } },
                { "if": { "properties": { "action": { "const": "moved-in" } } }, "then": { "required": ["added"] } }
              ]
            }
          },
          "starting_tokens": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provenance", "tokens"],
            "properties": {
              "provenance": { "const": "assumed" },
              "tokens": { "type": "object" }
            }
          },
          "gate_policy": { "type": "object" },
          "attributes": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["attribute", "value", "share", "platformShare", "weak"],
              "properties": {
                "attribute": { "type": "string", "pattern": "^[a-z_]+$" },
                "value": { "type": "string", "minLength": 1 },
                "share": { "type": "number" },
                "platformShare": { "type": "number" },
                "weak": { "type": "boolean" }
              }
            }
          },
          "mobbinUrls": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^https://mobbin\\.com/(screens|flows)/[0-9a-f-]{36}$" }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ease-design.dev/schemas/ds-kit-lock.schema.json",
  "title": "Bound owner kit lock",
  "description": "Generated by adoption and sanctioned evolution. The kernel additionally verifies sorted indices, portable paths, source/receipt closure, current projections and every byte hash.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "staleReasons", "contentHash", "content", "evidence", "registry", "tokensHash", "registryHash"],
  "properties": {
    "version": { "const": 1 },
    "status": { "enum": ["verified", "stale"] },
    "staleReasons": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "contentHash": { "$ref": "#/$defs/canonicalHash" },
    "tokensHash": { "$ref": "#/$defs/canonicalHash" },
    "registryHash": { "$ref": "#/$defs/canonicalHash" },
    "content": { "$ref": "#/$defs/fileIndex" },
    "evidence": { "$ref": "#/$defs/fileIndex" },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "components"],
      "properties": {
        "version": { "const": "0.1.0" },
        "components": {
          "type": "array",
          "items": { "$ref": "source-authored-component.schema.json" }
        }
      }
    }
  },
  "allOf": [{
    "if": { "properties": { "status": { "const": "verified" } } },
    "then": { "properties": { "staleReasons": { "maxItems": 0 } } },
    "else": { "properties": { "staleReasons": { "minItems": 1 } } }
  }],
  "$defs": {
    "canonicalHash": { "type": "string", "pattern": "^sha256-[A-Za-z0-9_-]{43}$" },
    "fileIndex": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "hash"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-os.dev/schemas/native-mobile-proof-manifest.schema.json",
  "title": "DESIGN:OS native mobile proof manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "routingBaseGitSha", "assurance", "claimPolicy", "generatedAt", "knownFailures", "arms"],
  "properties": {
    "kind": { "const": "design-os.native-mobile-proof" },
    "version": { "const": 2 },
    "routingBaseGitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "assurance": { "const": "PROVISIONAL" },
    "claimPolicy": { "const": "QUALIFIED_DELIVERY_FORBIDDEN" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "knownFailures": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "arms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/arm" },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["capabilityId"],
            "properties": { "capabilityId": { "const": "native-ios" } }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["capabilityId"],
            "properties": { "capabilityId": { "const": "native-ipados" } }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "$defs": {
    "digestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityId", "artifact", "briefId", "briefSha256", "sourceTreeSha256"],
      "properties": {
        "capabilityId": { "enum": ["native-ios", "native-ipados"] },
        "artifact": { "enum": ["native-ios-application", "native-ipados-application"] },
        "briefId": { "type": "string", "minLength": 1 },
        "briefSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourceTreeSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "controllerVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unitTests", "uiTests", "failures", "exitCode"],
      "properties": {
        "unitTests": { "type": "integer", "minimum": 0 },
        "uiTests": { "type": "integer", "minimum": 0 },
        "failures": { "type": "integer", "minimum": 0 },
        "exitCode": { "type": "integer" }
      }
    },
    "tier3Behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "controllerVerification", "environment", "evidence"],
      "properties": {
        "subject": { "$ref": "#/$defs/subject" },
        "controllerVerification": { "$ref": "#/$defs/controllerVerification" },
        "environment": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/digestRef" } }
      }
    },
    "tier3Visual": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "currentCuration": { "$ref": "#/$defs/digestRef" },
        "reviewReceipt": { "$ref": "#/$defs/digestRef" },
        "captureLedger": { "$ref": "#/$defs/digestRef" }
      }
    },
    "tier3Witnesses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generatorId", "behaviorDisposition", "visualDisposition", "behavior", "visual"],
      "properties": {
        "generatorId": { "type": "string", "minLength": 1 },
        "behaviorDisposition": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "visualDisposition": { "enum": ["PASS", "FAIL", "UNASSESSED"] },
        "behavior": { "type": "object" },
        "visual": { "$ref": "#/$defs/tier3Visual" }
      },
      "allOf": [
        {
          "if": { "properties": { "behaviorDisposition": { "const": "PASS" } }, "required": ["behaviorDisposition"] },
          "then": { "properties": { "behavior": { "$ref": "#/$defs/tier3Behavior" } } }
        },
        {
          "if": { "properties": { "visualDisposition": { "const": "PASS" } }, "required": ["visualDisposition"] },
          "then": { "properties": { "visual": { "allOf": [{ "$ref": "#/$defs/tier3Visual" }, { "required": ["currentCuration", "reviewReceipt", "captureLedger"] }] } } }
        },
        {
          "if": { "properties": { "visualDisposition": { "const": "UNASSESSED" } }, "required": ["visualDisposition"] },
          "then": { "properties": { "visual": { "allOf": [{ "$ref": "#/$defs/tier3Visual" }, { "required": ["reason"] }] } } }
        }
      ]
    },
    "pointSpaceGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinateSpace", "screens"],
      "properties": {
        "coordinateSpace": { "const": "points" },
        "screens": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["screenId", "kind", "viewport", "aboveFold"],
            "properties": {
              "screenId": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["catalog", "detail", "dictionary"] },
              "viewport": {
                "type": "object",
                "additionalProperties": false,
                "required": ["widthPoints", "heightPoints"],
                "properties": { "widthPoints": { "type": "number", "exclusiveMinimum": 0 }, "heightPoints": { "type": "number", "exclusiveMinimum": 0 } }
              },
              "aboveFold": {
                "type": "object",
                "additionalProperties": false,
                "required": ["completeRows"],
                "properties": {
                  "completeRows": { "type": "integer", "minimum": 0 },
                  "heroHeightPoints": { "type": "number", "minimum": 0 },
                  "nextSectionStartYPoints": { "type": "number", "minimum": 0 },
                  "chromeHeightPoints": { "type": "number", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "authorizedClaim", "environment", "evidence"],
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 6 },
        "status": { "enum": ["PASS", "FAIL", "PENDING", "NOT RUN"] },
        "authorizedClaim": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/digestRef" }, "uniqueItems": true },
        "witnesses": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "PASS" } }, "required": ["status"] },
          "then": { "properties": { "evidence": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "id": { "const": 3 } }, "required": ["id"] },
          "then": { "required": ["witnesses"], "properties": { "witnesses": { "$ref": "#/$defs/tier3Witnesses" } } }
        }
      ]
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityId", "artifact", "brief", "tiers"],
      "properties": {
        "capabilityId": { "enum": ["native-ios", "native-ipados"] },
        "artifact": { "enum": ["native-ios-application", "native-ipados-application"] },
        "brief": { "$ref": "#/$defs/digestRef" },
        "tiers": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/tier" },
          "allOf": [
            { "contains": { "properties": { "id": { "const": 1 } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
            { "contains": { "properties": { "id": { "const": 2 } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
            { "contains": { "properties": { "id": { "const": 3 } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
            { "contains": { "properties": { "id": { "const": 4 } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
            { "contains": { "properties": { "id": { "const": 5 } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
            { "contains": { "properties": { "id": { "const": 6 } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "capabilityId": { "const": "native-ios" } }, "required": ["capabilityId"] },
          "then": { "properties": { "artifact": { "const": "native-ios-application" } } }
        },
        {
          "if": { "properties": { "capabilityId": { "const": "native-ipados" } }, "required": ["capabilityId"] },
          "then": { "properties": { "artifact": { "const": "native-ipados-application" } } }
        }
      ]
    }
  }
}

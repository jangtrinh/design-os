{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ease-design/schemas/design-brief.schema.json",
  "title": "ease-design qualified delivery brief",
  "type": "object",
  "required": ["kind", "version", "rawRequest", "surface", "audience", "context", "primaryOutcome", "primaryAction", "requiredContent", "constraints", "prohibitedClaims", "criteria", "assumptions"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "design-brief" },
    "version": { "enum": [1, 2] },
    "rawRequest": { "type": "string", "minLength": 1 },
    "surface": {
      "description": "'marketing-landing' is the legacy value of 'landing' and stays valid. web-app, dashboard and mobile-app briefs are route-checked by `ui brief lint`.",
      "enum": ["marketing-landing", "landing", "web-app", "dashboard", "mobile-app", "email", "document"]
    },
    "activationRef": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "context": { "type": "string", "minLength": 1 },
    "primaryOutcome": { "type": "string", "minLength": 1 },
    "primaryAction": { "type": "string", "minLength": 1 },
    "requiredContent": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "prohibitedClaims": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "criteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "priority", "text"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "priority": { "enum": ["must", "should"] },
          "text": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "name", "states"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "states": { "type": "array", "items": { "enum": ["empty", "loading", "error", "partial", "full", "permission-denied"] } }
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object", "required": ["name", "scope"], "additionalProperties": false,
        "properties": { "name": { "type": "string", "minLength": 1 }, "scope": { "type": "string", "minLength": 1 } }
      }
    },
    "status": {
      "type": "object", "required": ["states"], "additionalProperties": false,
      "properties": {
        "states": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object", "required": ["from", "to"], "additionalProperties": false,
            "properties": { "from": { "type": "string", "minLength": 1 }, "to": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "copyLanguage": { "enum": ["en", "vi", "mixed"] },
    "requestedBy": { "type": "string", "minLength": 1 },
    "approvedBy": {
      "type": "array",
      "items": {
        "type": "object", "required": ["role", "person", "at"], "additionalProperties": false,
        "properties": {
          "role": { "enum": ["PM", "design-lead", "BA", "owner", "source"] },
          "person": { "type": "string", "minLength": 1 },
          "at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object", "required": ["facet", "value", "provenance", "confidence"], "additionalProperties": false,
        "properties": {
          "facet": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "minLength": 1 },
          "provenance": { "enum": ["provided", "project-evidence", "inferred", "unknown"] },
          "confidence": { "enum": ["high", "medium", "low"] },
          "label": { "enum": ["observed", "synthetic", "assumed"] }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "version": { "const": 2 } } },
      "then": { "required": ["activationRef"] }
    }
  ]
}

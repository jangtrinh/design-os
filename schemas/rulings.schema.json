{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ease-design/schemas/rulings.schema.json",
  "title": "ease-design rulings file",
  "description": "Curated, checkable design rulings. English is the source of truth; other languages are rendered, never authored.",
  "type": "object",
  "required": ["schema", "rulings"],
  "properties": {
    "schema": { "const": "rulings/1" },
    "at": { "description": "Epoch milliseconds of the last curation.", "type": "number" },
    "rulings": { "type": "array", "items": { "$ref": "#/definitions/ruling" } }
  },
  "definitions": {
    "scope": {
      "oneOf": [
        { "const": "global" },
        {
          "type": "object",
          "properties": {
            "apps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "features": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "screens": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "approval": {
      "type": "object",
      "required": ["role", "person", "at"],
      "properties": {
        "role": { "enum": ["PM", "design-lead", "BA", "owner", "source"] },
        "person": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "ruling": {
      "type": "object",
      "required": ["id", "category", "text", "scope", "source", "since", "verified_by"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/definitions/scope" },
        "source": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "since": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "verified_by": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "active", "superseded", "retired"] },
        "verified_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "approved_by": { "type": "array", "items": { "$ref": "#/definitions/approval" } },
        "principle": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "supersedes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "superseded_by": { "type": "string", "minLength": 1 },
        "conflicts_with": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "detail": { "type": "string" },
        "tag": { "type": "string" }
      }
    }
  }
}

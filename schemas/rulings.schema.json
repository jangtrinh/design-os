{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ease-design/schemas/rulings.schema.json",
  "title": "ease-design rulings ledger (draft)",
  "description": "Draft. Carries the seven fields every existing ruling has, plus the optional approved_by[] approval trail. Validation and the remaining optional fields are owned by the rulings-contract work; this file is schema only.",
  "type": "object",
  "required": ["schema", "rulings"],
  "properties": {
    "schema": { "const": "rulings/1" },
    "at": { "type": "integer" },
    "rulings": { "type": "array", "items": { "$ref": "#/definitions/ruling" } }
  },
  "definitions": {
    "approval": {
      "type": "object",
      "required": ["role", "person", "at"],
      "additionalProperties": false,
      "properties": {
        "role": { "enum": ["PM", "design-lead", "BA", "owner", "source"] },
        "person": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" }
      }
    },
    "ruling": {
      "type": "object",
      "required": ["id", "category", "text", "scope", "source", "since", "verified_by"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "scope": {
          "oneOf": [
            { "const": "global" },
            {
              "type": "object",
              "properties": {
                "apps": { "type": "array", "items": { "type": "string" } },
                "features": { "type": "array", "items": { "type": "string" } }
              }
            }
          ]
        },
        "source": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "since": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" }] },
        "verified_by": { "type": "string", "minLength": 1 },
        "approved_by": { "type": "array", "items": { "$ref": "#/definitions/approval" } }
      }
    }
  }
}

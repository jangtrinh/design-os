{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ease-design/schemas/method-run.schema.json",
  "title": "ease-design method run",
  "description": "One feature progresses through the same six design-thinking steps, regardless of school vocabulary.",
  "type": "object",
  "required": ["schema", "feature", "steps"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "method-run/1" },
    "feature": { "type": "string", "minLength": 1 },
    "school": { "enum": ["double-diamond", "jtbd", "lean-ux", "design-sprint", "none"] },
    "steps": {
      "type": "object",
      "required": ["frame", "define", "explore", "decide", "build", "verify"],
      "additionalProperties": false,
      "properties": {
        "frame": { "description": "Skip frame only when the feature's problem and audience are already anchored by current evidence.", "$ref": "#/definitions/step" },
        "define": { "description": "Skip define only when a current validated brief already defines this feature and its outcome.", "$ref": "#/definitions/step" },
        "explore": { "description": "Skip explore only when current evidence already covers the viable design options.", "$ref": "#/definitions/step" },
        "decide": { "description": "Skip decide only when a recorded human decision already selects the option for this feature.", "$ref": "#/definitions/step" },
        "build": { "description": "Skip build only when the chosen implementation already exists and is linked as evidence.", "$ref": "#/definitions/step" },
        "verify": { "description": "Skip verify only when current checks and the required human decision already have recorded evidence.", "$ref": "#/definitions/step" }
      }
    }
  },
  "definitions": {
    "step": {
      "type": "object",
      "required": ["status", "artifacts", "needs_humans"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["done", "skipped"] },
        "skip_reason": { "$ref": "#/definitions/skipReason" },
        "artifacts": { "type": "array", "items": { "$ref": "#/definitions/artifact" } },
        "needs_humans": { "type": "array", "items": { "$ref": "#/definitions/humanNeed" } }
      },
      "allOf": [{ "if": { "required": ["status"], "properties": { "status": { "const": "skipped" } } }, "then": { "required": ["skip_reason"] } }]
    },
    "skipReason": {
      "type": "object",
      "required": ["code", "detail"],
      "additionalProperties": false,
      "properties": {
        "code": { "enum": ["existing-evidence", "not-applicable", "out-of-scope", "blocked-intake"] },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "required": ["path", "provenance"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "provenance": { "enum": ["observed", "synthetic", "assumed"] }
      }
    },
    "humanNeed": {
      "type": "object",
      "required": ["question", "role"],
      "additionalProperties": false,
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "role": { "enum": ["PM", "design-lead", "BA", "owner"] },
        "answered_by": { "type": "string", "minLength": 1 },
        "answered_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}

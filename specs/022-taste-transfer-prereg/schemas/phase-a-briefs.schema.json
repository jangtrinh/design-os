{
  "$comment": "spec 022 — schema for phase-a-briefs.json. Exactly 16 briefs (4 families x 4). Cross-field rules (contradiction=ordinal 4, duplicate=ordinal 2, family/candidate consistency) are enforced by validate-prereg.mjs, not this schema.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "briefs": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "brief_id": {
            "type": "string",
            "pattern": "^PA-(AES|MOT|DEV|MED)-[1-4]$"
          },
          "family": {
            "type": "string",
            "enum": ["aesthetics", "motion", "devices", "media"]
          },
          "role": {
            "type": "string",
            "enum": ["ordinary", "contradiction"]
          },
          "ordinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "product": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "facts": {
                "type": "array",
                "minItems": 3,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "required": ["name", "facts"],
            "additionalProperties": false
          },
          "content_requirements": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "supplied_assets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "asset_id": { "type": "string", "minLength": 1 },
                "manifest_ref": { "type": "string", "minLength": 1 }
              },
              "required": ["asset_id", "manifest_ref"],
              "additionalProperties": false
            }
          },
          "acceptance_checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "check_id": { "type": "string", "minLength": 1 },
                "type": {
                  "type": "string",
                  "enum": ["selector-exists", "selector-absent", "text-present", "text-absent", "attr-check"]
                },
                "target": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 }
              },
              "required": ["check_id", "type", "target", "description"],
              "additionalProperties": false
            }
          },
          "gate_set": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["build", "console", "layout", "a11y", "content", "taste", "ds-usage", "reduced-motion"]
            }
          },
          "context_boundary": {
            "type": "string",
            "minLength": 1
          },
          "anti_context_condition": {
            "type": "string",
            "minLength": 1
          },
          "identical_across_arms": {
            "type": "array",
            "const": [
              "product.facts",
              "supplied_assets",
              "provider_identity",
              "environment",
              "orchestration",
              "token_ceiling",
              "repair_protocol",
              "viewports",
              "acceptance_checks",
              "gate_set"
            ]
          },
          "viewports": {
            "type": "array",
            "const": [390, 768, 1440]
          },
          "reduced_motion_required": {
            "type": "boolean"
          },
          "is_duplicate_source": {
            "type": "boolean"
          }
        },
        "required": [
          "brief_id",
          "family",
          "role",
          "ordinal",
          "title",
          "product",
          "content_requirements",
          "supplied_assets",
          "acceptance_checks",
          "gate_set",
          "context_boundary",
          "anti_context_condition",
          "identical_across_arms",
          "viewports",
          "reduced_motion_required",
          "is_duplicate_source"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "briefs"],
  "additionalProperties": false
}

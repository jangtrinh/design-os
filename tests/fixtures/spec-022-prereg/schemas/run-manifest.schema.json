{
  "$comment": "spec 022 — schema for a run-manifest.json (one per rendered arm). Not produced in this build stage; frozen ahead of render.",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^(PA|PB)-[A-Z0-9-]+-(control|treatment)$"
    },
    "pair_id": {
      "type": "string",
      "pattern": "^(PA-(AES|MOT|DEV|MED)-[1-4]|PB-(A[123]|M[123]|D[1-4]|P[12])-[1-3])$"
    },
    "phase": {
      "type": "string",
      "enum": ["A", "B"]
    },
    "family": {
      "type": "string",
      "enum": ["aesthetics", "motion", "devices", "media"]
    },
    "candidate_id": {
      "type": ["string", "null"],
      "enum": ["A1", "A2", "A3", "M1", "M2", "M3", "D1", "D2", "D3", "D4", "P1", "P2", null]
    },
    "arm": {
      "type": "string",
      "enum": ["control", "treatment"]
    },
    "brief_id": {
      "type": "string",
      "pattern": "^(PA-(AES|MOT|DEV|MED)-[1-4]|PB-(A[123]|M[123]|D[1-4]|P[12])-[1-3])$"
    },
    "brief_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prereg_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "control_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "upstream_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "provider": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "model_id": { "type": "string", "minLength": 1 },
        "params_note": { "type": "string", "minLength": 1 }
      },
      "required": ["name", "model_id", "params_note"],
      "additionalProperties": false
    },
    "patch_path": {
      "type": ["string", "null"],
      "pattern": "^patches/phase-(a/(aesthetics|motion|devices|media)|b/(A[123]|M[123]|D[1-4]|P[12]))\\.md$"
    },
    "patch_hash": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "prompt_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tree_clean": {
      "type": "boolean"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "initial": {
          "type": "object",
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          },
          "required": ["path", "sha256"],
          "additionalProperties": false
        },
        "repaired": {
          "type": ["object", "null"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          },
          "required": ["path", "sha256"],
          "additionalProperties": false
        },
        "primary": {
          "type": "string",
          "enum": ["initial", "repaired"]
        }
      },
      "required": ["initial", "repaired", "primary"],
      "additionalProperties": false
    },
    "gates": {
      "type": "object",
      "properties": {
        "initial": {
          "type": "object",
          "properties": {
            "envelope_path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "pass": { "type": "boolean" }
          },
          "required": ["envelope_path", "sha256", "pass"],
          "additionalProperties": false
        },
        "post_repair": {
          "type": ["object", "null"],
          "properties": {
            "envelope_path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "pass": { "type": "boolean" }
          },
          "required": ["envelope_path", "sha256", "pass"],
          "additionalProperties": false
        }
      },
      "required": ["initial", "post_repair"],
      "additionalProperties": false
    },
    "repair": {
      "type": "object",
      "properties": {
        "performed": { "type": "boolean" },
        "findings_hash": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": ["performed", "findings_hash"],
      "additionalProperties": false
    },
    "console_log": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "required": ["path", "sha256"],
      "additionalProperties": false
    },
    "screenshots": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "viewport": { "type": "integer", "enum": [390, 768, 1440] },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "required": ["viewport", "path", "sha256"],
        "additionalProperties": false
      }
    },
    "reduced_motion_capture": {
      "type": ["object", "null"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "required": ["path", "sha256"],
      "additionalProperties": false
    }
  },
  "required": [
    "run_id",
    "pair_id",
    "phase",
    "family",
    "candidate_id",
    "arm",
    "brief_id",
    "brief_hash",
    "prereg_commit",
    "control_commit",
    "upstream_commit",
    "provider",
    "patch_path",
    "patch_hash",
    "source_hashes",
    "prompt_hash",
    "tree_clean",
    "generated_at",
    "artifacts",
    "gates",
    "repair",
    "console_log",
    "screenshots",
    "reduced_motion_capture"
  ],
  "additionalProperties": false
}

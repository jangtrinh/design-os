{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist/types",
    "declaration": true,
    "declarationMap": true,
    "isolatedDeclarations": true,
    "emitDeclarationOnly": true,
    "noEmit": false
  },
  "include": ["src/lint.ts", "src/types/**/*.d.ts"]
}
